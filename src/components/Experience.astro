---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const resolvePublicPath = (path) =>
  path.startsWith("http") || path.startsWith("/") ? path : `${baseUrl}${path}`;
---

{
  hasExperience && (
    <section id="experience" class="p-6 sm:p-8 md:p-10 lg:p-12">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-4">
            <p
              class="mb-3 text-sm font-semibold uppercase tracking-wide"
              style={`color: ${siteConfig.accentColor}`}
              data-i18n="experience.eyebrow"
              >
                Awards & Practical Work
              </p>
            <h2 class="text-3xl font-bold text-white sm:text-4xl md:text-5xl xl:text-6xl">
              <span data-i18n="experience.heading">Experience</span>
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
            <p
              class="mt-5 max-w-sm text-sm leading-7 text-slate-200 sm:text-base"
              data-i18n="experience.intro"
            >
              Selected practical experiences where I worked with teams, built
              real solutions, and presented results under time pressure.
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-4">
              {siteConfig.experience.map((exp, index) => (
                <details class="experience-accordion motion-accordion rounded-lg border border-white/12 bg-white/8 shadow-sm transition-shadow duration-300 open:bg-white/12 open:shadow-[0_44px_120px_rgba(2,6,23,0.42)]">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-3.5 transition-colors hover:bg-white/12 sm:p-4 md:p-6">
                    <span class="min-w-0">
                      <span
                        class="block text-xl font-semibold text-white sm:text-2xl"
                        data-i18n={`experience.items.${index}.title`}
                      >
                        {exp.title}
                      </span>
                      <span
                        class="mt-1 block text-base font-medium sm:text-lg"
                        style={`color: ${siteConfig.accentColor}`}
                      >
                        {exp.company}
                      </span>
                    </span>
                    <span class="flex shrink-0 items-center gap-3">
                      <span class="hidden w-fit shrink-0 rounded-full border border-white/12 bg-white/8 px-2.5 py-0.5 text-[11px] font-medium text-slate-200 sm:inline-flex sm:text-xs">
                        {exp.dateRange}
                      </span>
                      <span class="experience-chevron flex shrink-0 items-center justify-center rounded-md border border-white/12 bg-slate-950/70 text-white transition-transform duration-300">
                        <svg
                          class="h-4 w-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"
                          />
                        </svg>
                      </span>
                    </span>
                  </summary>

                  <div class="accordion-panel">
                    <div class="accordion-panel-inner border-t border-white/10 p-4 sm:p-5 md:p-6">
                      <div
                        class={`grid gap-5 ${
                          exp.certificates && exp.certificates.length > 0
                            ? "lg:grid-cols-[minmax(0,1.18fr)_minmax(260px,0.82fr)] lg:items-start"
                            : ""
                        }`}
                      >
                        <div class="space-y-4">
                          <div class="flex flex-wrap items-center gap-3">
                            <span class="inline-flex w-fit shrink-0 rounded-full border border-white/12 bg-white/8 px-2.5 py-0.5 text-[11px] font-medium text-slate-200 sm:hidden">
                              {exp.dateRange}
                            </span>
                            {exp.link && (
                              <a
                                href={exp.link}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex w-fit items-center gap-2 rounded-md border border-cyan-300/30 bg-cyan-300/12 px-3 py-1.5 text-xs font-semibold text-cyan-100 transition-colors hover:bg-cyan-300/18 sm:text-sm"
                                data-i18n="experience.newsSource"
                              >
                                News source
                              </a>
                            )}
                          </div>

                          <ul class="space-y-3">
                            {exp.bullets.map((bullet, bulletIndex) => (
                              <li class="flex items-start">
                                <span
                                  class="mt-2 mr-3 h-1.5 w-1.5 flex-shrink-0 rounded-full"
                                  style={`background-color: ${siteConfig.accentColor}`}
                                />
                                <span
                                  class="text-sm leading-6 text-slate-200 sm:text-base"
                                  data-i18n={`experience.items.${index}.bullets.${bulletIndex}`}
                                >
                                  {bullet}
                                </span>
                              </li>
                            ))}
                          </ul>
                        </div>

                        {exp.certificates && exp.certificates.length > 0 && (
                          <div class="grid gap-4 sm:grid-cols-2">
                            {exp.certificates.map((certificate) => (
                              <div class="rounded-lg border border-dashed border-white/18 bg-white/6 p-2.5 sm:p-3">
                                {certificate.image ? (
                                  <a
                                    href={resolvePublicPath(certificate.image)}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="block rounded-md bg-slate-950/40 p-1.5 transition-colors hover:bg-slate-950/55"
                                  >
                                    <img
                                      src={resolvePublicPath(certificate.image)}
                                      alt={certificate.title}
                                      class="aspect-[3/4] w-full rounded-md object-contain"
                                    />
                                  </a>
                                ) : (
                                  <div
                                    class="flex aspect-[3/4] items-center justify-center rounded-md bg-slate-950/40 text-center text-xs font-medium text-slate-400"
                                    data-i18n="certificates.placeholder"
                                  >
                                    Certificate photo placeholder
                                  </div>
                                )}
                                <h4
                                  class="mt-2.5 text-xs font-semibold text-white sm:text-sm"
                                  data-i18n={`experience.items.${index}.certificates.${exp.certificates.indexOf(certificate)}.title`}
                                >
                                  {certificate.title}
                                </h4>
                                {certificate.note && (
                                  <p
                                    class="mt-1 text-[11px] leading-4 text-slate-300 sm:text-xs sm:leading-5"
                                    data-i18n={`experience.items.${index}.certificates.${exp.certificates.indexOf(certificate)}.note`}
                                  >
                                    {certificate.note}
                                  </p>
                                )}
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .experience-accordion > summary::-webkit-details-marker {
    display: none;
  }

  .experience-accordion[open] .experience-chevron {
    transform: rotate(180deg);
  }
</style>
