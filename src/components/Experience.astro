---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <p
              class="mb-3 text-sm font-semibold uppercase tracking-wide"
              style={`color: ${siteConfig.accentColor}`}
              data-i18n="experience.eyebrow"
            >
              Awards & Practical Work
            </p>
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              <span data-i18n="experience.heading">Experience</span>
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
            <p
              class="mt-5 max-w-sm text-sm sm:text-base leading-7 text-gray-600"
              data-i18n="experience.intro"
            >
              Selected practical experiences where I worked with teams, built
              real solutions, and presented results under time pressure.
            </p>
          </div>

          <div class="lg:col-span-8">
            <details class="collapsible-panel">
              <summary class="collapsible-button">What is this?</summary>
              <div class="mt-8 space-y-8">
              {siteConfig.experience.map((exp, index) => (
                <article class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition-shadow duration-300 hover:shadow-md sm:p-6 md:p-8">
                  <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                    <div class="min-w-0">
                      <h3
                        class="text-xl sm:text-2xl font-semibold text-gray-900"
                        data-i18n={`experience.items.${index}.title`}
                      >
                        {exp.title}
                      </h3>
                      <div class="mt-1 flex flex-wrap items-center gap-3">
                        <p
                          class="text-base sm:text-lg font-medium"
                          style={`color: ${siteConfig.accentColor}`}
                        >
                          {exp.company}
                        </p>
                        {exp.link && (
                          <a
                            href={exp.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sm font-medium text-gray-500 underline decoration-gray-300 underline-offset-4 transition-colors hover:text-gray-900"
                            data-i18n="experience.newsSource"
                          >
                            News source
                          </a>
                        )}
                      </div>
                    </div>
                    <span class="inline-flex w-fit shrink-0 rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-xs sm:text-sm font-medium text-gray-600">
                      {exp.dateRange}
                    </span>
                  </div>

                  <ul class="space-y-3">
                    {exp.bullets.map((bullet, bulletIndex) => (
                      <li class="flex items-start">
                        <span
                          class="mt-2 mr-3 h-1.5 w-1.5 flex-shrink-0 rounded-full"
                          style={`background-color: ${siteConfig.accentColor}`}
                        />
                        <span
                          class="text-sm sm:text-base leading-7 text-gray-600"
                          data-i18n={`experience.items.${index}.bullets.${bulletIndex}`}
                        >
                          {bullet}
                        </span>
                      </li>
                    ))}
                  </ul>

                  {exp.certificates && exp.certificates.length > 0 && (
                    <div class="mt-6 grid gap-3 sm:grid-cols-2">
                      {exp.certificates.map((certificate) => (
                        <div class="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
                          {certificate.image ? (
                            <img
                              src={certificate.image}
                              alt={certificate.title}
                              class="aspect-[4/3] w-full rounded-md object-cover"
                            />
                          ) : (
                            <div
                              class="flex aspect-[4/3] items-center justify-center rounded-md bg-white text-center text-sm font-medium text-gray-500"
                              data-i18n="certificates.placeholder"
                            >
                              Certificate photo placeholder
                            </div>
                          )}
                          <h4
                            class="mt-3 text-sm font-semibold text-gray-900"
                            data-i18n={`experience.items.${index}.certificates.${exp.certificates.indexOf(certificate)}.title`}
                          >
                            {certificate.title}
                          </h4>
                          {certificate.note && (
                            <p
                              class="mt-1 text-xs leading-5 text-gray-500"
                              data-i18n={`experience.items.${index}.certificates.${exp.certificates.indexOf(certificate)}.note`}
                            >
                              {certificate.note}
                            </p>
                          )}
                        </div>
                      ))}
                    </div>
                  )}
                </article>
              ))}
              </div>
            </details>
          </div>
        </div>
      </div>
    </section>
  )
}
