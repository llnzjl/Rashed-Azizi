---
import { siteConfig } from "../config";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<div
  id="hero"
  class="dynamic-hero relative isolate min-h-screen overflow-hidden bg-[#050816] text-white"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <canvas id="hero-3d-scene" class="absolute inset-0 z-0 h-full w-full"></canvas>
  <div class="absolute inset-0 z-[1] bg-[radial-gradient(circle_at_20%_20%,rgba(45,212,191,0.14),transparent_28%),radial-gradient(circle_at_80%_18%,rgba(37,28,215,0.18),transparent_30%),linear-gradient(135deg,rgba(5,8,22,0.72)_0%,rgba(16,24,39,0.62)_52%,rgba(29,16,44,0.74)_100%)]"></div>
  <div class="absolute inset-0 z-[2] bg-[linear-gradient(rgba(255,255,255,0.055)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.055)_1px,transparent_1px)] bg-[size:52px_52px] opacity-45"></div>
  <div class="hero-scanline absolute inset-x-0 top-0 z-[3] h-40 bg-gradient-to-b from-cyan-300/20 to-transparent"></div>

  <div class="relative z-10 mx-auto flex min-h-screen max-w-7xl items-center px-5 py-28 sm:px-8 lg:px-10">
    <div
      class="grid w-full items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(320px,0.72fr)]"
    >
      <div class="hero-copy hero-intro-copy w-full min-w-0 max-w-4xl">
      <h2
        class="text-pretty text-xl font-bold tracking-tight text-cyan-100 sm:text-2xl md:text-4xl"
        data-i18n="hero.greeting"
      >
        Hello!
      </h2>
      <h1
        class="mt-5 max-w-5xl text-pretty text-4xl font-black tracking-tight text-white sm:text-6xl md:text-7xl lg:text-8xl"
      >
        <span data-i18n="hero.namePrefix">My name is</span>
        <span class="hero-name block">{siteConfig.firstName}</span>
      </h1>
      <p
        class="mt-6 max-w-3xl text-pretty text-base font-medium leading-8 text-slate-200 sm:text-lg md:text-xl"
        data-i18n="hero.title"
      >
        {siteConfig.title}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`${baseUrl}about`} class="dynamic-button bg-white text-slate-950">About</a>
        <a href={`${baseUrl}projects`} class="dynamic-button border border-white/20 bg-white/10 text-white backdrop-blur">Projects</a>
      </div>
      </div>

      <div class="hero-panel hero-intro-panel relative mx-auto w-full max-w-md">
        <div class="tilt-card relative aspect-[4/5] overflow-hidden rounded-[2rem] border border-white/15 bg-white/10 p-4 shadow-2xl shadow-black/40 backdrop-blur-xl">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_10%,rgba(255,255,255,0.28),transparent_26%),linear-gradient(160deg,rgba(255,255,255,0.16),rgba(255,255,255,0.04))]"></div>
          <img
            src={`${baseUrl}${siteConfig.profileImage}`}
            alt={`${siteConfig.name} profile photo`}
            class="relative z-10 h-full w-full rounded-[1.5rem] object-cover grayscale-[15%]"
          />
          <div class="absolute bottom-8 left-8 right-8 z-20 rounded-xl border border-white/15 bg-slate-950/70 p-4 shadow-xl backdrop-blur">
            <p class="text-xs font-semibold uppercase text-cyan-200">Currently building</p>
            <p class="mt-1 text-lg font-bold text-white">Web, AI, and real-world tools</p>
          </div>
        </div>
        <div class="floating-chip left-0 top-8">C++</div>
        <div class="floating-chip right-0 top-24 animation-delay-200">AI</div>
        <div class="floating-chip bottom-12 left-6 animation-delay-400">SQL</div>
      </div>
    </div>
  </div>
  <div
    class="absolute bottom-6 left-5 right-5 z-10 flex items-center justify-between gap-5 text-white sm:left-8 sm:right-8 lg:left-10 lg:right-10"
  >
    <div class="flex gap-x-4 sm:gap-x-5">
    {
      siteConfig.social?.email && (
        <a
          href={`mailto:${siteConfig.social.email}`}
          aria-label="Email"
          class="social-orbit"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
            <path d="M3 7l9 6l9 -6" />
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.linkedin && (
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="social-orbit"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M8 11v5" />
              <path d="M8 8v.01" />
              <path d="M12 16v-5" />
              <path d="M16 16v-3a2 2 0 1 0 -4 0" />
              <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
            </>
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.instagram && (
        <a
          href={siteConfig.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="social-orbit"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z" />
              <path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
              <path d="M16.5 7.5v.01" />
            </>
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.github && (
        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="social-orbit"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
            </>
          </svg>
        </a>
      )
    }
    </div>
  </div>
</div>

<script>
  import * as THREE from "three";

  let heroSceneCleanup = () => {};
  let hasSeenInitialPageLoad = false;

  const setupHeroScene = () => {
    heroSceneCleanup();

    const canvas = document.getElementById("hero-3d-scene");

    if (!(canvas instanceof HTMLCanvasElement)) {
      return;
    }

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(55, 1, 0.1, 100);
    camera.position.set(0, 0, 9);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.8));

    const pointer = new THREE.Vector2(0, 0);
    const group = new THREE.Group();
    scene.add(group);

    const colors = [0x38bdf8, 0x2dd4bf, 0xa78bfa, 0xffffff];
    const geometry = new THREE.IcosahedronGeometry(1, 2);
    const material = new THREE.MeshStandardMaterial({
      color: 0x7dd3fc,
      roughness: 0.24,
      metalness: 0.58,
      emissive: 0x0f172a,
      emissiveIntensity: 0.35,
      wireframe: true,
    });
    const core = new THREE.Mesh(geometry, material);
    group.add(core);

    const ringMaterial = new THREE.MeshBasicMaterial({
      color: 0x67e8f9,
      transparent: true,
      opacity: 0.18,
      side: THREE.DoubleSide,
    });
    const rings = [1.9, 2.55, 3.25].map((radius, index) => {
      const ring = new THREE.Mesh(
        new THREE.TorusGeometry(radius, 0.012, 12, 160),
        ringMaterial.clone(),
      );
      ring.rotation.x = Math.PI / (2.4 + index * 0.26);
      ring.rotation.y = index * 0.72;
      group.add(ring);
      return ring;
    });

    const particleCount = 1200;
    const positions = new Float32Array(particleCount * 3);
    const particleColors = new Float32Array(particleCount * 3);

    for (let i = 0; i < particleCount; i += 1) {
      const radius = 4 + Math.random() * 7;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);
      positions[i * 3] = radius * Math.sin(phi) * Math.cos(theta);
      positions[i * 3 + 1] = radius * Math.sin(phi) * Math.sin(theta);
      positions[i * 3 + 2] = radius * Math.cos(phi);

      const color = new THREE.Color(colors[i % colors.length]);
      particleColors[i * 3] = color.r;
      particleColors[i * 3 + 1] = color.g;
      particleColors[i * 3 + 2] = color.b;
    }

    const particlesGeometry = new THREE.BufferGeometry();
    particlesGeometry.setAttribute("position", new THREE.BufferAttribute(positions, 3));
    particlesGeometry.setAttribute("color", new THREE.BufferAttribute(particleColors, 3));

    const particleMaterial = new THREE.PointsMaterial({
      size: 0.035,
      vertexColors: true,
      transparent: true,
      opacity: 0.72,
      depthWrite: false,
    });
    const particles = new THREE.Points(particlesGeometry, particleMaterial);
    scene.add(particles);

    scene.add(new THREE.AmbientLight(0xffffff, 0.7));
    const light = new THREE.PointLight(0x67e8f9, 18, 25);
    light.position.set(3, 4, 4);
    scene.add(light);

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      renderer.setSize(rect.width, rect.height, false);
      camera.aspect = rect.width / rect.height;
      camera.updateProjectionMatrix();
    };

    const onPointerMove = (event) => {
      pointer.x = (event.clientX / window.innerWidth - 0.5) * 2;
      pointer.y = (event.clientY / window.innerHeight - 0.5) * 2;
    };

    const heroSceneAbortController = new AbortController();
    const { signal } = heroSceneAbortController;

    window.addEventListener("resize", resize, { signal });
    window.addEventListener("pointermove", onPointerMove, { signal });
    resize();

    const clock = new THREE.Clock();
    let animationFrameId = 0;
    const animate = () => {
      const elapsed = clock.getElapsedTime();
      group.rotation.y += 0.004;
      group.rotation.x = Math.sin(elapsed * 0.7) * 0.18 + pointer.y * 0.12;
      group.position.x += (pointer.x * 0.55 - group.position.x) * 0.04;
      group.position.y += (-pointer.y * 0.35 - group.position.y) * 0.04;

      core.rotation.x = elapsed * 0.42;
      core.rotation.z = elapsed * 0.28;
      rings.forEach((ring, index) => {
        ring.rotation.z = elapsed * (0.18 + index * 0.05);
      });
      particles.rotation.y = elapsed * 0.035;
      particles.rotation.x = pointer.y * 0.06;

      renderer.render(scene, camera);
      animationFrameId = window.requestAnimationFrame(animate);
    };

    animationFrameId = window.requestAnimationFrame(animate);

    heroSceneCleanup = () => {
      heroSceneAbortController.abort();
      window.cancelAnimationFrame(animationFrameId);
      renderer.dispose();
      geometry.dispose();
      material.dispose();
      ringMaterial.dispose();
      rings.forEach((ring) => {
        ring.geometry.dispose();
        ring.material.dispose();
      });
      particlesGeometry.dispose();
      particleMaterial.dispose();
      scene.clear();
      heroSceneCleanup = () => {};
    };
  };

  const handlePageLoad = () => {
    if (!hasSeenInitialPageLoad) {
      hasSeenInitialPageLoad = true;
      return;
    }

    setupHeroScene();
  };

  setupHeroScene();
  document.addEventListener("astro:page-load", handlePageLoad);
</script>

<style>
  .hero-intro-copy,
  .hero-intro-panel {
    opacity: 0;
    will-change: transform, opacity, filter;
  }

  .hero-intro-copy {
    --intro-offset-x: -88px;
    --intro-offset-y: 0px;
    --intro-z: -180px;
    --intro-rotate-x: 10deg;
    --intro-rotate-y: 18deg;
    --intro-overshoot-x: 18px;
    --intro-overshoot-y: 0px;
    transform-origin: left center;
    animation: heroIntro3d 960ms cubic-bezier(0.16, 1, 0.3, 1) 0ms both;
  }

  .hero-intro-panel {
    --intro-offset-x: 88px;
    --intro-offset-y: 0px;
    --intro-z: -180px;
    --intro-rotate-x: 10deg;
    --intro-rotate-y: -18deg;
    --intro-overshoot-x: -18px;
    --intro-overshoot-y: 0px;
    transform-origin: right center;
    animation: heroIntro3d 960ms cubic-bezier(0.16, 1, 0.3, 1) 150ms both;
  }

  @keyframes heroIntro3d {
    0% {
      opacity: 0;
      filter: blur(14px);
      transform: perspective(1500px) translate3d(var(--intro-offset-x), var(--intro-offset-y), var(--intro-z)) rotateY(var(--intro-rotate-y)) rotateX(var(--intro-rotate-x)) scale(0.92);
    }
    68% {
      opacity: 1;
      filter: blur(0);
      transform: perspective(1500px) translate3d(var(--intro-overshoot-x), var(--intro-overshoot-y), 28px) rotateY(0deg) rotateX(0deg) scale(1.02);
    }
    100% {
      opacity: 1;
      filter: blur(0);
      transform: perspective(1500px) translate3d(0, 0, 0) rotateY(0deg) rotateX(0deg) scale(1);
    }
  }

  .dynamic-hero {
    perspective: 1200px;
  }

  .hero-copy {
    max-width: min(56rem, calc(100vw - 2.5rem));
  }

  .hero-copy p,
  .hero-copy h1,
  .hero-copy h2 {
    max-width: 100%;
    overflow-wrap: break-word;
  }

  .hero-copy,
  .hero-panel {
    transform-style: preserve-3d;
  }

  .hero-name {
    background: linear-gradient(90deg, #ffffff, #67e8f9, #a78bfa);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 24px 70px rgba(45, 212, 191, 0.28);
  }

  .dynamic-button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    border-radius: 0.5rem;
    padding: 0.75rem 1.1rem;
    font-size: 0.875rem;
    font-weight: 800;
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      background-color 220ms ease;
  }

  .dynamic-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 45px rgba(45, 212, 191, 0.2);
  }

  .tilt-card {
    transform-style: preserve-3d;
    animation: cardFloat 6s ease-in-out infinite;
  }

  .floating-chip {
    position: absolute;
    z-index: 30;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 0.5rem;
    background: rgba(15, 23, 42, 0.78);
    padding: 0.7rem 0.9rem;
    color: #cffafe;
    font-size: 0.78rem;
    font-weight: 900;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(14px);
    animation: chipFloat 4.8s ease-in-out infinite;
  }

  .social-orbit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.08);
    color: white;
    backdrop-filter: blur(12px);
    transition:
      transform 220ms ease,
      color 220ms ease,
      border-color 220ms ease;
  }

  .social-orbit:hover {
    color: #67e8f9;
    border-color: rgba(103, 232, 249, 0.55);
    transform: translateY(-4px) rotateX(10deg);
  }

  .hero-scanline {
    animation: scanline 7s linear infinite;
  }

  @keyframes cardFloat {
    0%,
    100% {
      transform: rotateX(0deg) rotateY(-3deg) translateY(0);
    }
    50% {
      transform: rotateX(3deg) rotateY(4deg) translateY(-14px);
    }
  }

  @keyframes chipFloat {
    0%,
    100% {
      transform: translate3d(0, 0, 36px);
    }
    50% {
      transform: translate3d(0, -14px, 58px);
    }
  }

  @keyframes scanline {
    0% {
      transform: translateY(-14rem);
      opacity: 0;
    }
    20%,
    65% {
      opacity: 1;
    }
    100% {
      transform: translateY(110vh);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-intro-copy,
    .hero-intro-panel {
      opacity: 1;
      animation: none;
      filter: none;
      transform: none;
    }

    .tilt-card,
    .floating-chip,
    .hero-scanline {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .hero-intro-copy {
      --intro-offset-x: 0px;
      --intro-offset-y: -52px;
      --intro-z: -120px;
      --intro-rotate-x: 20deg;
      --intro-rotate-y: 0deg;
      --intro-overshoot-x: 0px;
      --intro-overshoot-y: 12px;
      transform-origin: top center;
    }

    .hero-intro-panel {
      --intro-offset-x: 0px;
      --intro-offset-y: 52px;
      --intro-z: -120px;
      --intro-rotate-x: -20deg;
      --intro-rotate-y: 0deg;
      --intro-overshoot-x: 0px;
      --intro-overshoot-y: -12px;
      transform-origin: bottom center;
    }
  }
</style>
