---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const resolvePublicPath = (path) =>
  path.startsWith("http") || path.startsWith("/") ? path : `${baseUrl}${path}`;
---

{
  hasEducation && (
    <section id="education" class="p-8 sm:p-12 md:p-16 lg:p-12">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-4">
            <p
              class="mb-3 text-sm font-semibold uppercase tracking-wide"
              style={`color: ${siteConfig.accentColor}`}
              data-i18n="education.eyebrow"
            >
              Academic Background
            </p>
            <h2 class="text-3xl font-bold text-white sm:text-4xl md:text-5xl xl:text-7xl">
              <span data-i18n="education.heading">Education</span>
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
            <p
              class="mt-5 max-w-sm text-sm leading-7 text-slate-200 sm:text-base"
              data-i18n="education.intro"
            >
              My education reflects persistence, adaptability, and growth across
              different learning environments.
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="relative space-y-6 before:absolute before:left-4 before:top-3 before:hidden before:h-[calc(100%-1.5rem)] before:w-px before:bg-white/12 sm:before:block">
              {siteConfig.education.map((edu, eduIndex) => (
                <details class="education-accordion relative rounded-lg border border-white/12 bg-white/8 shadow-sm transition-shadow duration-300 open:bg-white/12 open:shadow-[0_24px_60px_rgba(2,6,23,0.28)] sm:ml-12">
                  <div
                    class="absolute -left-[3.25rem] top-7 hidden h-8 w-8 items-center justify-center rounded-full border-4 border-slate-950/80 text-sm font-bold text-white shadow-sm sm:flex"
                    style={`background-color: ${siteConfig.accentColor}`}
                  >
                    {eduIndex + 1}
                  </div>

                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 transition-colors hover:bg-white/12 sm:p-6 md:p-8 lg:p-5">
                    <span class="min-w-0">
                      <span
                        class="block text-xl font-semibold text-white sm:text-2xl"
                        data-i18n={`education.degree${eduIndex + 1}`}
                      >
                        {edu.degree}
                      </span>
                      <span
                        class="mt-1 block text-base font-medium sm:text-lg"
                        style={`color: ${siteConfig.accentColor}`}
                        data-i18n={`education.school${eduIndex + 1}`}
                      >
                        {edu.school}
                      </span>
                    </span>
                    <span class="flex shrink-0 items-center gap-3">
                      <span class="hidden w-fit shrink-0 rounded-full border border-white/12 bg-white/8 px-3 py-1 text-xs font-medium text-slate-200 sm:inline-flex lg:px-2.5 lg:py-0.5 lg:text-[11px]">
                        {edu.dateRange}
                      </span>
                      <span class="education-chevron flex shrink-0 items-center justify-center rounded-md border border-white/12 bg-slate-950/70 text-white transition-transform duration-300">
                        <svg
                          class="h-5 w-5"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"
                          />
                        </svg>
                      </span>
                    </span>
                  </summary>

                  <div class="border-t border-white/10 p-5 sm:p-6 md:p-8 lg:p-6">
                    <div
                      class={`grid gap-5 ${
                        edu.certificates && edu.certificates.length > 0
                          ? "lg:grid-cols-[minmax(0,1.18fr)_minmax(260px,0.82fr)] lg:items-start"
                          : ""
                      }`}
                    >
                      <div class="space-y-4">
                        <span class="inline-flex w-fit shrink-0 rounded-full border border-white/12 bg-white/8 px-3 py-1 text-xs font-medium text-slate-200 sm:hidden">
                          {edu.dateRange}
                        </span>

                        <ul class="space-y-3">
                          {edu.achievements.map((achievement, achievementIndex) => (
                            <li class="flex items-start">
                              <span
                                class="mt-2 mr-3 h-1.5 w-1.5 flex-shrink-0 rounded-full"
                                style={`background-color: ${siteConfig.accentColor}`}
                              />
                              <span
                                class="text-sm leading-7 text-slate-200 sm:text-base lg:text-sm"
                                data-i18n={`education.achievement${eduIndex * 3 + achievementIndex + 1}`}
                              >
                                {achievement}
                              </span>
                            </li>
                          ))}
                        </ul>
                      </div>

                      {edu.certificates && edu.certificates.length > 0 && (
                        <div class="grid gap-4 sm:grid-cols-2">
                          {edu.certificates.map((certificate) => (
                            <div class="rounded-lg border border-dashed border-white/18 bg-white/6 p-3 sm:p-4">
                              {certificate.image ? (
                                <a
                                  href={resolvePublicPath(certificate.image)}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="block rounded-md bg-slate-950/40 p-2 transition-colors hover:bg-slate-950/55"
                                >
                                  <img
                                    src={resolvePublicPath(certificate.image)}
                                    alt={certificate.title}
                                    class="aspect-[3/4] w-full rounded-md object-contain"
                                  />
                                </a>
                              ) : (
                                <div
                                  class="flex aspect-[3/4] items-center justify-center rounded-md bg-slate-950/40 p-4 text-center text-sm font-medium text-slate-400"
                                  data-i18n="certificates.placeholder"
                                >
                                  Certificate photo placeholder
                                </div>
                              )}
                              <h4 class="mt-3 text-sm font-semibold text-white">
                                {certificate.title}
                              </h4>
                              {certificate.note && (
                                <p class="mt-1 text-xs leading-5 text-slate-300">
                                  {certificate.note}
                                </p>
                              )}
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .education-accordion > summary::-webkit-details-marker {
    display: none;
  }

  .education-accordion[open] .education-chevron {
    transform: rotate(180deg);
  }
</style>
