---
import { siteConfig } from "../config";

const personalProjects = siteConfig.personalProjects ?? [];
const teamProjects = siteConfig.teamProjects ?? siteConfig.projects ?? [];
const hasProjects = personalProjects.length > 0 || teamProjects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              <span data-i18n="projects.heading">Projects</span>
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8 space-y-14">
            <div>
              <h3 class="text-2xl sm:text-3xl font-bold text-gray-900">
                <span data-i18n="projects.personal">Personal Projects</span>
              </h3>
              <div
                class="w-[48px] h-[4px] mt-2 mb-6 rounded-full"
                style={`background-color: ${siteConfig.accentColor}`}
              />
              {personalProjects.length > 0 ? (
                <div class="space-y-8">
                  {
                    personalProjects.map((project, index) => {
                      const Component = project.link ? "a" : "div";
                      const linkProps = project.link
                        ? {
                            href: project.link,
                            target: "_blank",
                            rel: "noopener noreferrer",
                          }
                        : {};

                      return (
                        <div class="group relative">
                          <Component
                            {...linkProps}
                            class={`block relative p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 ${
                              project.link
                                ? "hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1"
                                : ""
                            }`}
                          >
                            {project.link && (
                              <div class="absolute top-4 right-4 sm:top-6 sm:right-6 md:top-8 md:right-8 w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 group-hover:bg-gray-700">
                                <svg
                                  class="w-4 h-4 sm:w-4.5 sm:h-4.5 md:w-5 md:h-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                                  fill="none"
                                  stroke="currentColor"
                                  viewBox="0 0 24 24"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M7 17L17 7M17 7H7M17 7V17"
                                  />
                                </svg>
                              </div>
                            )}

                            <div class="space-y-4">
                              <div>
                                <span
                                  class="text-sm font-mono"
                                  style={{ color: siteConfig.accentColor }}
                                >
                                  {String(index + 1).padStart(2, "0")}
                                </span>
                                <h3
                                  class="text-xl sm:text-2xl font-bold text-gray-900 mt-1"
                                  data-i18n={`projects.personalItems.${index}.name`}
                                >
                                  {project.name}
                                </h3>
                              </div>

                              <p
                                class={`text-base sm:text-lg text-gray-600 leading-relaxed ${project.link ? "pr-12 sm:pr-14 md:pr-16" : ""}`}
                                data-i18n={`projects.personalItems.${index}.description`}
                              >
                                {project.description}
                              </p>

                              {project.skills &&
                                project.skills.length > 0 && (
                                  <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                                    {project.skills.map((skill) => (
                                      <span
                                        class={`px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-all duration-300 ${
                                          project.link
                                            ? "group-hover:bg-gray-800"
                                            : ""
                                        }`}
                                      >
                                        {skill}
                                      </span>
                                    ))}
                                  </div>
                                )}
                            </div>
                          </Component>
                        </div>
                      );
                    })
                  }
                </div>
              ) : (
                <div
                  class="rounded-xl border border-gray-200 bg-gray-50 p-6 text-gray-600"
                  data-i18n="projects.personalEmpty"
                >
                  Personal projects will be added here soon.
                </div>
              )}
            </div>

            <div>
              <h3 class="text-2xl sm:text-3xl font-bold text-gray-900">
                <span data-i18n="projects.team">Team Projects</span>
              </h3>
              <div
                class="w-[48px] h-[4px] mt-2 mb-6 rounded-full"
                style={`background-color: ${siteConfig.accentColor}`}
              />
              <div class="space-y-8">
                {
                  teamProjects.map((project, index) => {
                    const Component = project.link ? "a" : "div";
                    const linkProps = project.link
                      ? {
                          href: project.link,
                          target: "_blank",
                          rel: "noopener noreferrer",
                        }
                      : {};

                    return (
                      <div class="group relative">
                        <Component
                          {...linkProps}
                          class={`block relative p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 ${
                            project.link
                              ? "hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1"
                              : ""
                          }`}
                        >
                          {project.link && (
                            <div class="absolute top-4 right-4 sm:top-6 sm:right-6 md:top-8 md:right-8 w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 group-hover:bg-gray-700">
                              <svg
                                class="w-4 h-4 sm:w-4.5 sm:h-4.5 md:w-5 md:h-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M7 17L17 7M17 7H7M17 7V17"
                                />
                              </svg>
                            </div>
                          )}

                          <div class="space-y-4">
                            <div>
                              <span
                                class="text-sm font-mono"
                                style={{ color: siteConfig.accentColor }}
                              >
                                {String(index + 1).padStart(2, "0")}
                              </span>
                              <h3
                                class="text-xl sm:text-2xl font-bold text-gray-900 mt-1"
                                data-i18n={`projects.teamItems.${index}.name`}
                              >
                                {project.name}
                              </h3>
                            </div>

                            <p
                              class={`text-base sm:text-lg text-gray-600 leading-relaxed ${project.link ? "pr-12 sm:pr-14 md:pr-16" : ""}`}
                              data-i18n={`projects.teamItems.${index}.description`}
                            >
                              {project.description}
                            </p>

                            {project.skills && project.skills.length > 0 && (
                              <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                                {project.skills.map((skill) => (
                                  <span
                                    class={`px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-all duration-300 ${
                                      project.link
                                        ? "group-hover:bg-gray-800"
                                        : ""
                                    }`}
                                  >
                                    {skill}
                                  </span>
                                ))}
                              </div>
                            )}

                            {project.certificates &&
                              project.certificates.length > 0 && (
                                <div class="grid gap-3 pt-3 sm:grid-cols-2">
                                  {project.certificates.map((certificate) => (
                                    <div class="rounded-lg border border-dashed border-gray-300 bg-white p-4">
                                      {certificate.image ? (
                                        <img
                                          src={certificate.image}
                                          alt={certificate.title}
                                          class="aspect-[4/3] w-full rounded-md object-cover"
                                        />
                                      ) : (
                                        <div
                                          class="flex aspect-[4/3] items-center justify-center rounded-md bg-gray-50 text-center text-sm font-medium text-gray-500"
                                          data-i18n="certificates.placeholder"
                                        >
                                          Certificate photo placeholder
                                        </div>
                                      )}
                                      <h4
                                        class="mt-3 text-sm font-semibold text-gray-900"
                                        data-i18n={`projects.teamItems.${index}.certificates.${project.certificates.indexOf(certificate)}.title`}
                                      >
                                        {certificate.title}
                                      </h4>
                                      {certificate.note && (
                                        <p
                                          class="mt-1 text-xs leading-5 text-gray-500"
                                          data-i18n={`projects.teamItems.${index}.certificates.${project.certificates.indexOf(certificate)}.note`}
                                        >
                                          {certificate.note}
                                        </p>
                                      )}
                                    </div>
                                  ))}
                                </div>
                              )}
                          </div>
                        </Component>
                      </div>
                    );
                  })
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
