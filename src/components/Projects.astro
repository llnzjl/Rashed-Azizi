---
import { siteConfig } from "../config";

const personalProjects = siteConfig.personalProjects ?? [];
const teamProjects = siteConfig.teamProjects ?? siteConfig.projects ?? [];
const hasProjects = personalProjects.length > 0 || teamProjects.length > 0;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const resolvePublicPath = (path) =>
  path.startsWith("http") || path.startsWith("/") ? path : `${baseUrl}${path}`;
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              <span data-i18n="projects.heading">Projects</span>
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8 space-y-14">
            <div>
              <h3 class="text-2xl sm:text-3xl font-bold text-gray-900">
                <span data-i18n="projects.personal">Personal Projects</span>
              </h3>
              <div
                class="w-[48px] h-[4px] mt-2 mb-6 rounded-full"
                style={`background-color: ${siteConfig.accentColor}`}
              />
              {personalProjects.length > 0 ? (
                <div class="space-y-4">
                  {personalProjects.map((project, index) => (
                    <details class="project-accordion rounded-xl sm:rounded-2xl border border-gray-200 bg-gray-50 transition-all duration-300 open:bg-white open:shadow-xl">
                      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 transition-colors hover:bg-white sm:p-6 md:p-8">
                        <span class="min-w-0">
                          <span
                            class="block text-sm font-mono"
                            style={{ color: siteConfig.accentColor }}
                          >
                            {String(index + 1).padStart(2, "0")}
                          </span>
                          <span
                            class="mt-1 block text-xl font-bold text-gray-900 sm:text-2xl"
                            data-i18n={`projects.personalItems.${index}.name`}
                          >
                            {project.name}
                          </span>
                        </span>
                        <span class="project-chevron flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-gray-900 text-white transition-transform duration-300">
                          <svg
                            class="h-5 w-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M19 9l-7 7-7-7"
                            />
                          </svg>
                        </span>
                      </summary>

                      <div class="space-y-4 border-t border-gray-200 p-4 sm:p-6 md:p-8">
                        <p
                          class="text-base sm:text-lg text-gray-600 leading-relaxed"
                          data-i18n={`projects.personalItems.${index}.description`}
                        >
                          {project.description}
                        </p>

                        {project.skills && project.skills.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                            {project.skills.map((skill) => (
                              <span class="px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium">
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}

                        {project.link && (
                          <a
                            href={project.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex w-fit items-center gap-2 rounded-md bg-gray-900 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-gray-700"
                          >
                            View project
                            <svg
                              class="h-4 w-4"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M7 17L17 7M17 7H7M17 7V17"
                              />
                            </svg>
                          </a>
                        )}
                      </div>
                    </details>
                  ))}
                </div>
              ) : (
                <div
                  class="rounded-xl border border-gray-200 bg-gray-50 p-6 text-gray-600"
                  data-i18n="projects.personalEmpty"
                >
                  Personal projects will be added here soon.
                </div>
              )}
            </div>

            <div>
              <h3 class="text-2xl sm:text-3xl font-bold text-gray-900">
                <span data-i18n="projects.team">Team Projects</span>
              </h3>
              <div
                class="w-[48px] h-[4px] mt-2 mb-6 rounded-full"
                style={`background-color: ${siteConfig.accentColor}`}
              />
              <div class="space-y-4">
                {teamProjects.map((project, index) => (
                  <details class="project-accordion rounded-xl sm:rounded-2xl border border-gray-200 bg-gray-50 transition-all duration-300 open:bg-white open:shadow-xl">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 transition-colors hover:bg-white sm:p-6 md:p-8">
                      <span class="min-w-0">
                        <span
                          class="block text-sm font-mono"
                          style={{ color: siteConfig.accentColor }}
                        >
                          {String(index + 1).padStart(2, "0")}
                        </span>
                        <span
                          class="mt-1 block text-xl font-bold text-gray-900 sm:text-2xl"
                          data-i18n={`projects.teamItems.${index}.name`}
                        >
                          {project.name}
                        </span>
                      </span>
                      <span class="project-chevron flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-gray-900 text-white transition-transform duration-300">
                        <svg
                          class="h-5 w-5"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"
                          />
                        </svg>
                      </span>
                    </summary>

                    <div class="space-y-4 border-t border-gray-200 p-4 sm:p-6 md:p-8">
                      <p
                        class="text-base sm:text-lg text-gray-600 leading-relaxed"
                        data-i18n={`projects.teamItems.${index}.description`}
                      >
                        {project.description}
                      </p>

                      {project.skills && project.skills.length > 0 && (
                        <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                          {project.skills.map((skill) => (
                            <span class="px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium">
                              {skill}
                            </span>
                          ))}
                        </div>
                      )}

                      {project.link && (
                        <a
                          href={project.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex w-fit items-center gap-2 rounded-md bg-gray-900 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-gray-700"
                        >
                          View project
                          <svg
                            class="h-4 w-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 17L17 7M17 7H7M17 7V17"
                            />
                          </svg>
                        </a>
                      )}

                      {project.certificates &&
                        project.certificates.length > 0 && (
                          <div class="grid gap-5 pt-4 sm:grid-cols-2">
                            {project.certificates.map((certificate) => (
                              <div class="rounded-lg border border-dashed border-gray-300 bg-white p-3 sm:p-4">
                                {certificate.image ? (
                                  <a
                                    href={resolvePublicPath(certificate.image)}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="block rounded-md bg-gray-50 p-2 transition-colors hover:bg-gray-100"
                                  >
                                    <img
                                      src={resolvePublicPath(certificate.image)}
                                      alt={certificate.title}
                                      class="aspect-[3/4] w-full rounded-md object-contain"
                                    />
                                  </a>
                                ) : (
                                  <div
                                    class="flex aspect-[3/4] items-center justify-center rounded-md bg-gray-50 text-center text-sm font-medium text-gray-500"
                                    data-i18n="certificates.placeholder"
                                  >
                                    Certificate photo placeholder
                                  </div>
                                )}
                                <h4
                                  class="mt-3 text-sm font-semibold text-gray-900"
                                  data-i18n={`projects.teamItems.${index}.certificates.${project.certificates.indexOf(certificate)}.title`}
                                >
                                  {certificate.title}
                                </h4>
                                {certificate.note && (
                                  <p
                                    class="mt-1 text-xs leading-5 text-gray-500"
                                    data-i18n={`projects.teamItems.${index}.certificates.${project.certificates.indexOf(certificate)}.note`}
                                  >
                                    {certificate.note}
                                  </p>
                                )}
                              </div>
                            ))}
                          </div>
                        )}
                    </div>
                  </details>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .project-accordion > summary::-webkit-details-marker {
    display: none;
  }

  .project-accordion[open] .project-chevron {
    transform: rotate(180deg);
  }
</style>
