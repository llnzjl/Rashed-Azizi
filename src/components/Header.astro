---
import { siteConfig, translations } from "../config";

const hasProjects =
  (siteConfig.personalProjects && siteConfig.personalProjects.length > 0) ||
  (siteConfig.teamProjects && siteConfig.teamProjects.length > 0) ||
  (siteConfig.projects && siteConfig.projects.length > 0);
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const navItems = [
  {
    href: `${baseUrl}#home`,
    key: "nav.main",
    label: "Home",
    angle: -90,
    visible: true,
  },
  {
    href: `${baseUrl}#about`,
    key: "nav.about",
    label: "About",
    angle: -18,
    visible: true,
  },
  {
    href: `${baseUrl}#projects`,
    key: "nav.projects",
    label: "Projects",
    angle: 54,
    visible: hasProjects,
  },
  {
    href: `${baseUrl}#experience`,
    key: "nav.experience",
    label: "Experience",
    angle: 126,
    visible: hasExperience,
  },
  {
    href: `${baseUrl}#education`,
    key: "nav.education",
    label: "Education",
    angle: 198,
    visible: hasEducation,
  },
];
---

<header
  id="header"
  class="fixed inset-x-0 top-0 z-50 pointer-events-none"
>
  <div class="mx-auto grid max-w-7xl grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-start gap-4 px-4 pt-4 sm:px-6 lg:px-8">
    <div class="pointer-events-auto flex items-start justify-start">
      <div
        class="language-orbit rounded-full border border-white/14 bg-slate-950/45 p-1 shadow-[inset_0_1px_0_rgba(255,255,255,0.12),0_18px_48px_rgba(2,6,23,0.28)] backdrop-blur"
        aria-label="Language selector"
        data-i18n-aria="header.language"
      >
        <button type="button" class="language-button rounded-full px-2.5 py-1.5 text-[11px] font-semibold text-slate-300 transition-all sm:text-xs" data-lang="en">EN</button>
        <button type="button" class="language-button rounded-full px-2.5 py-1.5 text-[11px] font-semibold text-slate-300 transition-all sm:text-xs" data-lang="ko">KO</button>
        <button type="button" class="language-button rounded-full px-2.5 py-1.5 text-[11px] font-semibold text-slate-300 transition-all sm:text-xs" data-lang="ps">PS</button>
        <button type="button" class="language-button rounded-full px-2.5 py-1.5 text-[11px] font-semibold text-slate-300 transition-all sm:text-xs" data-lang="fa">FA</button>
      </div>
    </div>

    <nav
      id="orbit-nav"
      class="orbit-nav pointer-events-auto relative mt-1 h-[16.5rem] w-[16.5rem] sm:h-[18.75rem] sm:w-[18.75rem] lg:h-[20.5rem] lg:w-[20.5rem]"
      aria-label="Primary"
    >
      <div class="orbit-nav-ring"></div>
      <div class="orbit-nav-core">
        <span class="orbit-nav-name">{siteConfig.firstName}</span>
        <span class="orbit-nav-tagline">Orbit menu</span>
      </div>
      {
        navItems
          .filter((item) => item.visible)
          .map((item) => (
            <a
              href={item.href}
              class="orbit-link group"
              style={`--orbit-angle: ${item.angle}deg; --orbit-radius: clamp(4.8rem, 14vw, 7rem);`}
              data-i18n={item.key}
            >
              <span class="orbit-link-label">{item.label}</span>
            </a>
          ))
      }
    </nav>

    <div class="pointer-events-none hidden lg:block"></div>
  </div>
</header>

<script define:vars={{ translations }}>
  const supportedLanguages = ["en", "ko", "ps", "fa"];
  const rtlLanguages = ["ps", "fa"];
  let headerAbortController = null;

  const getTranslation = (language, path) =>
    path.split(".").reduce((value, key) => value?.[key], translations[language]);

  const applyLanguage = (language) => {
    const activeLanguage = supportedLanguages.includes(language) ? language : "en";
    const isRtl = rtlLanguages.includes(activeLanguage);

    document.documentElement.lang = activeLanguage;
    document.documentElement.dir = isRtl ? "rtl" : "ltr";
    localStorage.setItem("portfolio-language", activeLanguage);

    document.querySelectorAll("[data-i18n]").forEach((element) => {
      const key = element.getAttribute("data-i18n");
      const value = key ? getTranslation(activeLanguage, key) : "";
      if (typeof value === "string") {
        element.textContent = value;
      }
    });

    document.querySelectorAll("[data-i18n-aria]").forEach((element) => {
      const key = element.getAttribute("data-i18n-aria");
      const value = key ? getTranslation(activeLanguage, key) : "";
      if (typeof value === "string") {
        element.setAttribute("aria-label", value);
      }
    });

    document.querySelectorAll(".language-button").forEach((button) => {
      const isActive = button.getAttribute("data-lang") === activeLanguage;
      button.classList.toggle("language-button-active", isActive);
      button.classList.toggle("text-slate-950", isActive);
      button.classList.toggle("text-slate-300", !isActive);
    });
  };

  const syncOrbitLinks = (activeKey) => {
    document.querySelectorAll(".orbit-link").forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) {
        return;
      }

      const linkHash = new URL(link.href, window.location.origin).hash.replace("#", "");
      const isHomeLink = linkHash === "home";
      const isActive = linkHash ? linkHash === activeKey : activeKey === "home";

      link.classList.toggle("orbit-link-active", isActive);
      if (isActive) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }

      link.dataset.linkState = isHomeLink ? "home" : "section";
    });
  };

  const getInitialSectionKey = () => {
    const hash = window.location.hash.replace("#", "");
    if (hash) {
      return hash;
    }

    const path = window.location.pathname.replace(/\/+$/, "") || "/";
    if (path === "/") {
      return "home";
    }

    const slug = path.split("/").filter(Boolean).at(-1) || "home";
    return slug;
  };

  const initHeaderControls = () => {
    headerAbortController?.abort();
    headerAbortController = new AbortController();
    const { signal } = headerAbortController;

    document.querySelectorAll(".language-button").forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          applyLanguage(button.getAttribute("data-lang") || "en");
        },
        { signal },
      );
    });

    const orbitSections = Array.from(document.querySelectorAll("[data-orbit-section]"));
    const orbitObserver = orbitSections.length
      ? new IntersectionObserver(
          (entries) => {
            const visibleSections = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
            if (!visibleSections.length) {
              return;
            }

            const activeKey =
              visibleSections[0].target.getAttribute("data-orbit-section") ||
              visibleSections[0].target.id ||
              "home";
            syncOrbitLinks(activeKey);
          },
          {
            rootMargin: "-40% 0px -44% 0px",
            threshold: [0.12, 0.24, 0.36],
          },
        )
      : null;

    orbitSections.forEach((section) => {
      orbitObserver?.observe(section);
    });

    signal.addEventListener(
      "abort",
      () => {
        orbitObserver?.disconnect();
      },
      { once: true },
    );

    const refreshOrbitState = () => {
      syncOrbitLinks(getInitialSectionKey());
    };

    window.addEventListener("hashchange", refreshOrbitState, { signal });

    applyLanguage(localStorage.getItem("portfolio-language") || "en");
    refreshOrbitState();
  };

  initHeaderControls();
  document.addEventListener("astro:page-load", initHeaderControls);

  window.addEventListener("storage", (event) => {
    if (event.key === "portfolio-language" && event.newValue) {
      applyLanguage(event.newValue);
    }
  });
</script>

<script>
  let dynamicEffectsAbortController = null;
  let dynamicEffectsObserver = null;
  let dynamicEffectsHasSeenInitialPageLoad = false;

  const setupDynamicEffects = () => {
    dynamicEffectsAbortController?.abort();
    dynamicEffectsAbortController = new AbortController();
    const { signal } = dynamicEffectsAbortController;
    dynamicEffectsObserver?.disconnect();
    dynamicEffectsObserver = null;
    const isProjectsPage = document.body.classList.contains("projects-page");

    const revealTargets = [
      ...document.querySelectorAll(".reveal-on-scroll"),
      ...document.querySelectorAll(".orbit-reveal"),
      ...document.querySelectorAll("main section > div"),
      ...document.querySelectorAll(".page-surface"),
      ...document.querySelectorAll(".project-accordion, .experience-accordion, .education-accordion"),
    ];
    const useStaticReveal =
      window.matchMedia("(max-width: 767px)").matches ||
      window.matchMedia("(hover: none)").matches ||
      window.matchMedia("(pointer: coarse)").matches ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    revealTargets.forEach((element) => element.classList.add("reveal-on-scroll"));

    if (useStaticReveal) {
      revealTargets.forEach((element) => element.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14, rootMargin: "0px 0px -8% 0px" },
    );
    dynamicEffectsObserver = observer;

    revealTargets.forEach((element) => observer.observe(element));

    const bindSmoothTilt = (element, config) => {
      let currentX = 0;
      let currentY = 0;
      let currentLift = 0;
      let targetX = 0;
      let targetY = 0;
      let targetLift = 0;
      let frameId = 0;
      let pointerActive = false;

      element.__codexTilt = {
        x: 0,
        y: 0,
        lift: 0,
      };

      const queueFrame = () => {
        if (!frameId) {
          frameId = window.requestAnimationFrame(render);
        }
      };

      const render = () => {
        frameId = 0;
        currentX += (targetX - currentX) * config.smoothing;
        currentY += (targetY - currentY) * config.smoothing;
        currentLift += (targetLift - currentLift) * config.liftSmoothing;

        element.style.transform = `perspective(${config.perspective}px) translate3d(0, 0, ${currentLift}px) rotateX(${currentY}deg) rotateY(${currentX}deg) scale(${config.scale})`;
        element.__codexTilt = {
          x: currentX,
          y: currentY,
          lift: currentLift,
        };

        const settled =
          Math.abs(targetX - currentX) < 0.01 &&
          Math.abs(targetY - currentY) < 0.01 &&
          Math.abs(targetLift - currentLift) < 0.01;

        if (!settled || pointerActive) {
          queueFrame();
        }
      };

      const updateTargets = (event) => {
        if (!(event instanceof PointerEvent)) {
          return;
        }

        const rect = element.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;

        targetX = x * config.maxRotateY;
        targetY = -y * config.maxRotateX;
        targetLift = config.lift;
        pointerActive = true;
        queueFrame();
      };

      const releaseTargets = () => {
        pointerActive = false;
        targetX = 0;
        targetY = 0;
        targetLift = 0;
        queueFrame();
      };

      element.addEventListener("pointerenter", updateTargets, { signal });
      element.addEventListener("pointermove", updateTargets, { signal });
      element.addEventListener("pointerleave", releaseTargets, { signal });
      element.addEventListener("pointercancel", releaseTargets, { signal });
      signal.addEventListener(
        "abort",
        () => {
          if (frameId) {
            window.cancelAnimationFrame(frameId);
          }
          element.style.transform = "";
          element.__codexTilt = {
            x: 0,
            y: 0,
            lift: 0,
          };
        },
        { once: true },
      );
    };

    const bindAccordionBurst = (details) => {
      const summary = details.querySelector("summary");
      const panel = details.querySelector(".accordion-panel");
      const panelInner = details.querySelector(".accordion-panel-inner");

      if (
        !(summary instanceof HTMLElement) ||
        !(panel instanceof HTMLElement) ||
        !(panelInner instanceof HTMLElement)
      ) {
        return;
      }

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (prefersReducedMotion) {
        return;
      }

      const isCompactViewport = window.matchMedia("(max-width: 767px)").matches;
      const openDuration = isCompactViewport ? 760 : 980;
      const childDuration = isCompactViewport ? 660 : 860;
      const depthZ = isCompactViewport ? 160 : 260;
      const summaryDepth = isCompactViewport ? 20 : 36;

      const cancelAnimations = () => {
        panel.getAnimations().forEach((animation) => animation.cancel());
        summary.getAnimations().forEach((animation) => animation.cancel());
        Array.from(panelInner.children).forEach((child) => {
          if (child instanceof HTMLElement) {
            child.getAnimations().forEach((animation) => animation.cancel());
          }
        });
      };

      const animateOpen = () => {
        const tilt = details.__codexTilt ?? { x: 0, y: 0, lift: 0 };
        const startRotateY = Math.max(-14, Math.min(14, tilt.x * 2.8));
        const startRotateX = Math.max(-12, Math.min(12, tilt.y * -2.4));
        const startLift = Math.max(0, Math.min(14, -tilt.lift * 0.2));
        const panelStartDepth = Math.max(0, startLift * 0.25);
        const childElements = Array.from(panelInner.children).filter((child) => child instanceof HTMLElement);

        panel.animate(
          [
            {
              opacity: 0,
              transform: `perspective(1600px) translate3d(0, -42px, -${depthZ}px) rotateX(${startRotateX - 10}deg) rotateY(${startRotateY}deg) scale(0.9)`,
            },
            {
              opacity: 1,
              offset: 0.68,
              transform: `perspective(1600px) translate3d(0, 8px, ${panelStartDepth + 36}px) rotateX(5deg) rotateY(${-startRotateY / 4}deg) scale(1.02)`,
            },
            {
              opacity: 1,
              transform: "perspective(1600px) translate3d(0, 0, 0) rotateX(0deg) rotateY(0deg) scale(1)",
            },
          ],
          {
            duration: openDuration,
            easing: "cubic-bezier(0.16, 1, 0.3, 1)",
          },
        );

        summary.animate(
          [
            {
              transform: `perspective(1600px) translate3d(0, 0, ${startLift}px) rotateX(${startRotateX * 0.15}deg) rotateY(${startRotateY * 0.15}deg) scale(1)`,
            },
            {
              offset: 0.62,
              transform: `perspective(1600px) translate3d(0, -2px, ${summaryDepth}px) rotateX(${startRotateX * 0.08}deg) rotateY(${startRotateY * 0.08}deg) scale(1.01)`,
            },
            {
              transform: "perspective(1600px) translate3d(0, 0, 0) rotateX(0deg) rotateY(0deg) scale(1)",
            },
          ],
          {
            duration: openDuration - 80,
            easing: "cubic-bezier(0.16, 1, 0.3, 1)",
          },
        );

        childElements.forEach((child, index) => {
          child.animate(
            [
              {
                opacity: 0,
                transform: `translate3d(0, 20px, -${Math.round(depthZ * 0.6)}px) rotateX(-18deg) rotateY(${startRotateY / 3}deg) scale(0.94)`,
              },
              {
                opacity: 1,
                offset: 0.7,
                transform: "translate3d(0, -2px, 24px) rotateX(4deg) rotateY(-1deg) scale(1.01)",
              },
              {
                opacity: 1,
                transform: "translate3d(0, 0, 0) rotateX(0deg) rotateY(0deg) scale(1)",
              },
            ],
            {
              duration: childDuration,
              delay: 48 + index * (isCompactViewport ? 56 : 84),
              easing: "cubic-bezier(0.16, 1, 0.3, 1)",
            },
          );
        });
      };

      details.addEventListener(
        "toggle",
        () => {
          cancelAnimations();
          if (!details.open) {
            return;
          }

          animateOpen();
        },
        { signal },
      );

      signal.addEventListener(
        "abort",
        () => {
          cancelAnimations();
        },
        { once: true },
      );
    };

    document.querySelectorAll(".tilt-card, .page-surface, .project-accordion, .experience-accordion, .education-accordion").forEach((card) => {
      const config = isProjectsPage
        ? card.classList.contains("page-surface")
          ? {
              perspective: 1080,
              maxRotateX: 3.5,
              maxRotateY: 4.5,
              lift: -5,
              scale: 1.005,
              smoothing: 0.11,
              liftSmoothing: 0.14,
            }
          : {
              perspective: 1020,
              maxRotateX: 2.8,
              maxRotateY: 3.6,
              lift: -3.5,
              scale: 1.003,
              smoothing: 0.1,
              liftSmoothing: 0.13,
            }
        : card.classList.contains("page-surface")
          ? {
              perspective: 1300,
              maxRotateX: 8,
              maxRotateY: 10,
              lift: -12,
              scale: 1.014,
              smoothing: 0.09,
              liftSmoothing: 0.12,
            }
          : card.classList.contains("tilt-card")
            ? {
                perspective: 1200,
                maxRotateX: 7,
                maxRotateY: 9,
                lift: -9,
                scale: 1.01,
                smoothing: 0.095,
                liftSmoothing: 0.12,
              }
            : {
                perspective: 1150,
                maxRotateX: 6,
                maxRotateY: 8,
                lift: -8,
                scale: 1.008,
                smoothing: 0.09,
                liftSmoothing: 0.12,
              };

      bindSmoothTilt(card, config);
    });

    document.querySelectorAll(".motion-accordion").forEach((details) => {
      if (details instanceof HTMLElement) {
        bindAccordionBurst(details);
      }
    });
  };

  const handlePageLoad = () => {
    if (!dynamicEffectsHasSeenInitialPageLoad) {
      dynamicEffectsHasSeenInitialPageLoad = true;
      return;
    }

    setupDynamicEffects();
  };

  setupDynamicEffects();
  document.addEventListener("astro:page-load", handlePageLoad);
</script>

<style>
  html {
    scroll-behavior: smooth;
  }

  #header {
    background:
      linear-gradient(180deg, rgba(2, 6, 23, 0.72), rgba(15, 23, 42, 0.2)),
      rgba(15, 23, 42, 0.18);
    backdrop-filter: blur(18px);
  }

  .language-orbit,
  .orbit-nav,
  .orbit-nav-core,
  .orbit-link {
    transform-style: preserve-3d;
    will-change: transform;
  }

  .language-button {
    min-width: 2.15rem;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    transition:
      background-color 220ms ease,
      color 220ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
  }

  .language-button:hover {
    transform: translateY(-1px);
  }

  .language-button-active {
    background: linear-gradient(135deg, rgba(186, 230, 253, 0.98), rgba(103, 232, 249, 0.9));
    color: rgb(15, 23, 42);
    box-shadow: 0 10px 24px rgba(186, 230, 253, 0.26);
  }

  .orbit-nav {
    isolation: isolate;
  }

  .orbit-nav-ring {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background:
      radial-gradient(circle at center, rgba(103, 232, 249, 0.14), transparent 56%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 26px 80px rgba(2, 6, 23, 0.28);
    pointer-events: none;
  }

  .orbit-nav-core {
    position: absolute;
    inset: 28%;
    display: grid;
    place-items: center;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background:
      radial-gradient(circle at 30% 28%, rgba(103, 232, 249, 0.22), transparent 34%),
      linear-gradient(160deg, rgba(15, 23, 42, 0.96), rgba(30, 41, 59, 0.85));
    box-shadow:
      0 28px 70px rgba(2, 6, 23, 0.36),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    text-align: center;
    pointer-events: none;
  }

  .orbit-nav-name {
    display: block;
    font-size: 1.15rem;
    font-weight: 800;
    color: white;
    letter-spacing: 0.04em;
  }

  .orbit-nav-tagline {
    margin-top: 0.2rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(203, 213, 225, 0.8);
  }

  .orbit-link {
    position: absolute;
    top: 50%;
    left: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 4.45rem;
    padding: 0.55rem 0.85rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(15, 23, 42, 0.6);
    color: rgba(226, 232, 240, 0.96);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    backdrop-filter: blur(14px);
    transform:
      translate(-50%, -50%)
      rotate(var(--orbit-angle))
      translateY(calc(var(--orbit-radius) * -1))
      rotate(calc(var(--orbit-angle) * -1));
    transition:
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 220ms ease,
      background-color 220ms ease,
      color 220ms ease,
      box-shadow 220ms ease;
  }

  .orbit-link:hover {
    border-color: rgba(103, 232, 249, 0.48);
    background: rgba(255, 255, 255, 0.14);
    color: white;
    box-shadow: 0 16px 34px rgba(8, 47, 73, 0.24);
    transform:
      translate(-50%, -50%)
      rotate(var(--orbit-angle))
      translateY(calc(var(--orbit-radius) * -1))
      rotate(calc(var(--orbit-angle) * -1))
      scale(1.04);
  }

  .orbit-link-active {
    border-color: rgba(103, 232, 249, 0.5);
    background: linear-gradient(135deg, rgba(103, 232, 249, 0.22), rgba(45, 212, 191, 0.16));
    color: white;
    box-shadow:
      0 16px 34px rgba(8, 47, 73, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit-link,
    .language-button {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .orbit-nav {
      width: 15rem;
      height: 15rem;
    }

    .orbit-nav-core {
      inset: 30%;
    }

    .orbit-nav-name {
      font-size: 0.95rem;
    }

    .orbit-link {
      min-width: 3.75rem;
      padding: 0.42rem 0.6rem;
      font-size: 0.58rem;
    }
  }
</style>
