---
import { siteConfig, translations } from "../config";

const hasProjects =
  (siteConfig.personalProjects && siteConfig.personalProjects.length > 0) ||
  (siteConfig.teamProjects && siteConfig.teamProjects.length > 0) ||
  (siteConfig.projects && siteConfig.projects.length > 0);
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const navItems = [
  {
    href: baseUrl,
    key: "nav.main",
    label: "Main",
    visible: true,
  },
  {
    href: `${baseUrl}about`,
    key: "nav.about",
    label: "About",
    visible: true,
  },
  {
    href: `${baseUrl}projects`,
    key: "nav.projects",
    label: "Projects",
    visible: hasProjects,
  },
  {
    href: `${baseUrl}experience`,
    key: "nav.experience",
    label: "Experience",
    visible: hasExperience,
  },
  {
    href: `${baseUrl}education`,
    key: "nav.education",
    label: "Education",
    visible: hasEducation,
  },
];
---

<header
  id="header"
  class="fixed left-0 right-0 top-0 z-50 border-b border-white/20 bg-slate-950/35 shadow-[0_20px_60px_rgba(15,23,42,0.18)] backdrop-blur-xl transition-all duration-300"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8">
    <a href={baseUrl} class="min-w-0 truncate text-base font-bold text-white drop-shadow-[0_8px_28px_rgba(103,232,249,0.18)]">
      {siteConfig.firstName}
    </a>

    <div class="flex items-center gap-2">
      <div
        class="flex rounded-xl border border-white/15 bg-slate-950/45 p-1 shadow-[inset_0_1px_0_rgba(255,255,255,0.12)] backdrop-blur"
        aria-label="Language selector"
        data-i18n-aria="header.language"
      >
        <button type="button" class="language-button rounded-lg px-2 py-1.5 text-sm font-semibold text-slate-300 transition-all" data-lang="en">EN</button>
        <button type="button" class="language-button rounded-lg px-2 py-1.5 text-sm font-semibold text-slate-300 transition-all" data-lang="ko">KO</button>
        <button type="button" class="language-button rounded-lg px-2 py-1.5 text-sm font-semibold text-slate-300 transition-all" data-lang="ps">PS</button>
        <button type="button" class="language-button rounded-lg px-2 py-1.5 text-sm font-semibold text-slate-300 transition-all" data-lang="fa">FA</button>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="menu-toggle inline-flex h-11 w-11 items-center justify-center rounded-xl border border-white/15 bg-white/10 text-white shadow-[0_18px_35px_rgba(15,23,42,0.24)] backdrop-blur transition-all duration-300 hover:border-cyan-300/45 hover:bg-white/14"
        aria-controls="site-menu"
        aria-expanded="false"
        aria-label="Menu"
        data-i18n-aria="header.menu"
      >
        <span class="sr-only" data-i18n="header.menu">Menu</span>
        <span class="menu-glyph flex flex-col gap-1.5">
          <span class="menu-bar block h-0.5 w-5 rounded-full bg-current"></span>
          <span class="menu-bar block h-0.5 w-5 rounded-full bg-current"></span>
          <span class="menu-bar block h-0.5 w-5 rounded-full bg-current"></span>
        </span>
      </button>
    </div>
  </div>

  <nav
    id="site-menu"
    class="menu-panel absolute right-4 top-full mt-3 hidden w-[min(22rem,calc(100vw-2rem))] overflow-hidden rounded-[1.25rem] border border-white/15 bg-[linear-gradient(160deg,rgba(15,23,42,0.92),rgba(30,41,59,0.8))] p-3 text-white shadow-[0_30px_80px_rgba(2,6,23,0.45)] backdrop-blur-2xl sm:right-6 lg:right-8"
  >
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(103,232,249,0.18),transparent_34%),radial-gradient(circle_at_bottom_right,rgba(167,139,250,0.18),transparent_30%)]"></div>
    <div class="grid gap-2">
      {
        navItems
          .filter((item) => item.visible)
          .map((item, index) => (
            <a
              href={item.href}
              class="menu-link group relative flex items-center justify-between gap-4 overflow-hidden rounded-xl border border-white/8 bg-white/6 px-3 py-3 text-sm font-medium text-slate-100 transition-all duration-300 hover:border-cyan-300/35 hover:bg-white/12 hover:text-white"
              data-i18n={item.key}
            >
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-black/20 text-[11px] font-bold text-cyan-200">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="flex-1 text-right">{item.label}</span>
            </a>
          ))
      }
    </div>
  </nav>
</header>

<script define:vars={{ translations }}>
  const supportedLanguages = ["en", "ko", "ps", "fa"];
  const rtlLanguages = ["ps", "fa"];

  const getTranslation = (language, path) => {
    return path.split(".").reduce((value, key) => value?.[key], translations[language]);
  };

  const applyLanguage = (language) => {
    const activeLanguage = supportedLanguages.includes(language) ? language : "en";
    const isRtl = rtlLanguages.includes(activeLanguage);

    document.documentElement.lang = activeLanguage;
    document.documentElement.dir = isRtl ? "rtl" : "ltr";
    localStorage.setItem("portfolio-language", activeLanguage);

    document.querySelectorAll("[data-i18n]").forEach((element) => {
      const key = element.getAttribute("data-i18n");
      const value = key ? getTranslation(activeLanguage, key) : "";
      if (typeof value === "string") {
        element.textContent = value;
      }
    });

    document.querySelectorAll("[data-i18n-aria]").forEach((element) => {
      const key = element.getAttribute("data-i18n-aria");
      const value = key ? getTranslation(activeLanguage, key) : "";
      if (typeof value === "string") {
        element.setAttribute("aria-label", value);
      }
    });

    document.querySelectorAll(".language-button").forEach((button) => {
      const isActive = button.getAttribute("data-lang") === activeLanguage;
      button.classList.toggle("bg-sky-200", isActive);
      button.classList.toggle("shadow-[0_10px_24px_rgba(186,230,253,0.32)]", isActive);
      button.classList.toggle("text-slate-950", isActive);
      button.classList.toggle("bg-transparent", !isActive);
      button.classList.toggle("text-slate-300", !isActive);
    });
  };

  const highlightActiveNav = () => {
    const currentPath = window.location.pathname.replace(/\/+$/, "") || "/";
    document.querySelectorAll("#site-menu a").forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) {
        return;
      }

      const linkPath = new URL(link.href, window.location.origin).pathname.replace(/\/+$/, "") || "/";
      const isActive = linkPath === currentPath;
      link.classList.toggle("menu-link-active", isActive);
    });
  };

  const initLanguageControls = () => {
    const menu = document.getElementById("site-menu");
    const toggle = document.getElementById("menu-toggle");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const isStaticPointer =
      window.matchMedia("(hover: none)").matches || window.matchMedia("(pointer: coarse)").matches;

    const setMenuOpen = (isOpen) => {
      menu?.classList.toggle("hidden", !isOpen);
      menu?.classList.toggle("menu-open", isOpen);
      toggle?.classList.toggle("menu-open", isOpen);
      toggle?.setAttribute("aria-expanded", String(isOpen));
    };

    toggle?.addEventListener("click", () => {
      const isOpen = menu?.classList.contains("hidden") ?? true;
      setMenuOpen(isOpen);
    });

    menu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        setMenuOpen(false);
      });
    });

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Node)) {
        return;
      }

      if (!menu?.contains(event.target) && !toggle?.contains(event.target)) {
        setMenuOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setMenuOpen(false);
      }
    });

    if (!prefersReducedMotion.matches && !isStaticPointer) {
      [toggle, menu].forEach((element) => {
        element?.addEventListener("pointermove", (event) => {
          if (!(event instanceof PointerEvent) || !element) {
            return;
          }

          const rect = element.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width - 0.5;
          const y = (event.clientY - rect.top) / rect.height - 0.5;
          const rotateX = y * -10;
          const rotateY = x * 12;
          element.style.transform = `perspective(900px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-2px)`;
        });

        element?.addEventListener("pointerleave", () => {
          if (element) {
            element.style.transform = "";
          }
        });
      });
    }

    document.querySelectorAll(".language-button").forEach((button) => {
      button.addEventListener("click", () => {
        applyLanguage(button.getAttribute("data-lang") || "en");
      });
    });

    applyLanguage(localStorage.getItem("portfolio-language") || "en");
    highlightActiveNav();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLanguageControls);
  } else {
    initLanguageControls();
  }

  window.addEventListener("storage", (event) => {
    if (event.key === "portfolio-language" && event.newValue) {
      applyLanguage(event.newValue);
    }
  });
</script>

<script>
  const setupDynamicEffects = () => {
    const revealTargets = [
      ...document.querySelectorAll(".reveal-on-scroll"),
      ...document.querySelectorAll("main section > div"),
      ...document.querySelectorAll(".page-surface"),
      ...document.querySelectorAll(".project-accordion, .experience-accordion, .education-accordion"),
    ];
    const useStaticReveal =
      window.matchMedia("(max-width: 767px)").matches ||
      window.matchMedia("(hover: none)").matches ||
      window.matchMedia("(pointer: coarse)").matches ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    revealTargets.forEach((element) => element.classList.add("reveal-on-scroll"));

    if (useStaticReveal) {
      revealTargets.forEach((element) => element.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14, rootMargin: "0px 0px -8% 0px" },
    );

    revealTargets.forEach((element) => observer.observe(element));

    document.querySelectorAll(".tilt-card, .page-surface, .project-accordion, .experience-accordion, .education-accordion").forEach((card) => {
      card.addEventListener("pointermove", (event) => {
        if (!(event instanceof PointerEvent) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          return;
        }

        const rect = card.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        const depth = card.classList.contains("page-surface") ? -10 : -6;
        const rotateX = card.classList.contains("page-surface") ? y * -4.5 : y * -5;
        const rotateY = card.classList.contains("page-surface") ? x * 5.5 : x * 6;
        card.style.transform = `perspective(900px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(${depth}px)`;
      });

      card.addEventListener("pointerleave", () => {
        card.style.transform = "";
      });
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupDynamicEffects);
  } else {
    setupDynamicEffects();
  }
</script>

<style>
  html {
    scroll-behavior: smooth;
  }

  #header {
    background:
      linear-gradient(180deg, rgba(2, 6, 23, 0.7), rgba(15, 23, 42, 0.35)),
      rgba(15, 23, 42, 0.38);
  }

  .menu-toggle,
  .menu-panel {
    transform-style: preserve-3d;
    will-change: transform;
  }

  .menu-panel {
    transform-origin: top right;
  }

  .menu-panel.menu-open {
    animation: menuReveal 240ms ease-out forwards;
  }

  .menu-toggle.menu-open {
    box-shadow: 0 22px 44px rgba(8, 47, 73, 0.34);
  }

  .menu-toggle.menu-open .menu-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .menu-toggle.menu-open .menu-bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.menu-open .menu-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .menu-bar {
    transition:
      transform 220ms ease,
      opacity 220ms ease;
  }

  .menu-link::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(103, 232, 249, 0.14), transparent 60%);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .menu-link:hover::before {
    opacity: 1;
  }

  .menu-link-active {
    border-color: rgba(103, 232, 249, 0.38);
    background: rgba(255, 255, 255, 0.14);
    color: white;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 18px 30px rgba(8, 47, 73, 0.2);
  }

  .menu-link-active::before {
    opacity: 1;
  }

  @keyframes menuReveal {
    from {
      opacity: 0;
      transform: perspective(900px) rotateX(-12deg) translateY(-10px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: perspective(900px) rotateX(0deg) translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-panel.menu-open {
      animation: none;
    }

    .menu-bar,
    .menu-link::before {
      transition: none;
    }
  }
</style>
