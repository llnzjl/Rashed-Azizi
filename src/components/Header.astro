---
import { siteConfig } from "../config";

const hasProjects =
  (siteConfig.personalProjects && siteConfig.personalProjects.length > 0) ||
  (siteConfig.teamProjects && siteConfig.teamProjects.length > 0) ||
  (siteConfig.projects && siteConfig.projects.length > 0);
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 hidden md:block transition-all duration-300"
>
  <nav class="max-w-7xl mx-auto px-8 py-4">
    <ul class="flex items-center gap-8 justify-center">
      <li>
        <a
          href={baseUrl}
          class="text-gray-700 hover:text-black transition-colors font-medium"
          data-i18n="nav.main"
        >
          Main
        </a>
      </li>
      <li>
        <a
          href={`${baseUrl}#about`}
          class="text-gray-700 hover:text-black transition-colors font-medium"
          data-i18n="nav.about"
        >
          About
        </a>
      </li>
      {
        hasProjects && (
          <li>
            <a
              href={`${baseUrl}projects`}
              class="text-gray-700 hover:text-black transition-colors font-medium"
              data-i18n="nav.projects"
            >
              Projects
            </a>
          </li>
        )
      }
      {
        hasExperience && (
          <li>
            <a
              href={`${baseUrl}experience`}
              class="text-gray-700 hover:text-black transition-colors font-medium"
              data-i18n="nav.experience"
            >
              Experience
            </a>
          </li>
        )
      }
      {
        hasEducation && (
          <li>
            <a
              href={`${baseUrl}education`}
              class="text-gray-700 hover:text-black transition-colors font-medium"
              data-i18n="nav.education"
            >
              Education
            </a>
          </li>
        )
      }
      <li>
        <label class="sr-only" for="language-select">Language</label>
        <select
          id="language-select"
          class="language-select rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 outline-none transition-colors hover:border-gray-400 focus:border-[var(--accent-color)]"
          style={`--accent-color: ${siteConfig.accentColor}`}
          aria-label="Select language"
        >
          <option value="en">English</option>
          <option value="ko">한국어</option>
          <option value="fa">فارسی</option>
          <option value="ps">پښتو</option>
        </select>
      </li>
    </ul>
  </nav>
</header>

<div
  class="fixed left-0 right-0 top-0 z-50 flex items-center gap-2 overflow-x-auto border-b border-gray-200 bg-white/90 px-3 py-2 shadow-sm backdrop-blur-sm md:hidden"
>
  <a
    href={baseUrl}
    class="shrink-0 rounded-md px-2 py-1 text-sm font-medium text-gray-700 transition-colors hover:text-black"
    data-i18n="nav.main"
  >
    Main
  </a>
  <a
    href={`${baseUrl}#about`}
    class="shrink-0 rounded-md px-2 py-1 text-sm font-medium text-gray-700 transition-colors hover:text-black"
    data-i18n="nav.about"
  >
    About
  </a>
  {
    hasProjects && (
      <a
        href={`${baseUrl}projects`}
        class="shrink-0 rounded-md px-2 py-1 text-sm font-medium text-gray-700 transition-colors hover:text-black"
        data-i18n="nav.projects"
      >
        Projects
      </a>
    )
  }
  {
    hasExperience && (
      <a
        href={`${baseUrl}experience`}
        class="shrink-0 rounded-md px-2 py-1 text-sm font-medium text-gray-700 transition-colors hover:text-black"
        data-i18n="nav.experience"
      >
        Experience
      </a>
    )
  }
  {
    hasEducation && (
      <a
        href={`${baseUrl}education`}
        class="shrink-0 rounded-md px-2 py-1 text-sm font-medium text-gray-700 transition-colors hover:text-black"
        data-i18n="nav.education"
      >
        Education
      </a>
    )
  }
  <label class="sr-only" for="mobile-language-select">Language</label>
  <select
    id="mobile-language-select"
    class="language-select ml-auto shrink-0 rounded-md border border-gray-300 bg-white px-2 py-1 text-sm font-medium text-gray-700 outline-none transition-colors hover:border-gray-400 focus:border-[var(--accent-color)]"
    style={`--accent-color: ${siteConfig.accentColor}`}
    aria-label="Select language"
  >
    <option value="en">English</option>
    <option value="ko">한국어</option>
    <option value="fa">فارسی</option>
    <option value="ps">پښتو</option>
  </select>
</div>

